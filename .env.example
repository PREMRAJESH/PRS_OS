# Copy to .env.local and fill in real values. Never commit .env.local.
# All values here are server-side only. Do not prefix them with NEXT_PUBLIC_.

# ── Google Gemini (required) ──────────────────────────────────
# Used exclusively by /api/assistant.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# Free-tier keys allow only ~20 requests/day per model; enable billing for a
# public portfolio, or set a different model here.
GEMINI_MODEL=gemini-2.5-flash

# ── GitHub (optional) ─────────────────────────────────────────
# Raises the public API rate limit for live repository lookups.
GITHUB_TOKEN=

# ── Assistant abuse controls (optional) ───────────────────────
# Extra origins allowed to call /api/assistant, comma-separated. Same-origin
# browser requests and requests without an Origin header are always allowed.
# Example: https://app.example.com,https://premsargara.me
ASSISTANT_ALLOWED_ORIGINS=

# Max simultaneous upstream model requests per instance. Default 4.
ASSISTANT_MAX_CONCURRENCY=4

# Optional shared rate-limit store (Upstash Redis REST). When set, the
# per-IP limit is enforced across serverless instances. Without it, the
# in-memory window is best-effort per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Advanced / testing overrides (optional) ───────────────────
# Leave blank in production. Useful for a proxy or a local mock.
GEMINI_API_BASE=
GITHUB_API_BASE=

# ── Contact form (/api/send-mail) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
