# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Google Gemini (server-side only) ──────────────────────────
# Required. Used exclusively by /api/assistant. Never expose with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# Free-tier keys allow only ~20 requests/day per model; enable billing for a
# public portfolio, or set a different model here.
GEMINI_MODEL=gemini-2.5-flash

# ── GitHub (optional) ─────────────────────────────────────────
# Raises the public API rate limit for live repository lookups.
GITHUB_TOKEN=

# ── Contact form (/api/send-mail) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
